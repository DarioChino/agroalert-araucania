rules_version = '2';

// Cada persona dueña de una cuenta ve y controla solo sus propios datos en la nube.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /events/{eventId} {
        allow read, create: if request.auth != null && request.auth.uid == uid;
        allow update, delete: if false;
      }

      match /commands/{commandId} {
        allow read, create, delete: if request.auth != null && request.auth.uid == uid;
        allow update: if false;
      }
    }
  }
}
